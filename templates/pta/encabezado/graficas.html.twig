{# ============================================================
   PTA — GRÁFICAS
   ------------------------------------------------------------
   Vista de visualización gráfica del PTA.
   - Renderiza una gráfica por cada indicador
   - Muestra meta, tendencia y porcentaje de avance
   - Desglosa el aporte de cada acción
   ------------------------------------------------------------
   IMPORTANTE:
   - Twig SOLO renderiza estructura y data-attributes
   - Los cálculos ya vienen procesados desde el controlador
   ============================================================ #}

<section
	class="pta-module" data-pta-view="graficas">

	{# =========================================================
						       HEADER SUPERIOR
						       ========================================================= #}
	<header class="pta-module__header">

		<div class="pta-module__header-left">
			<a href="{{ path('app_encabezado_show', { id: encabezado.id, anio: filtros.anio, departamento: filtros.departamento, puesto: filtros.puesto }) }}" {% if app.user and 'ROLE_ADMIN' in app.user.roles %} data-turbo-frame="content" data-turbo-action="replace" {% endif %} class="pta-back-btn">
				<i class="bi bi-arrow-left"></i>
				<span>Volver</span>
			</a>
		</div>

		<h1 class="pta-module__title">
			📊 Gráficas del PTA
		</h1>

	</header>

	{# =========================================================
						       INFORMACIÓN DEL PROYECTO
						       ========================================================= #}
	<div class="pta-show">
		<div class="card pta-card pta-info-card mb-4">
			<h4 class="pta-title">
				<i class="bi bi-file-earmark-text"></i> Información del Proyecto
			</h4>

			<div class="pta-info-grid">
				<div class="pta-info-col-side">
					<div class="pta-anio-card pta-anio-card--stack mb-3">
						<label class="pta-field-label mb-2"># Proyecto</label>
						<div class="pta-show-year pta-show-year--compact">{{ encabezado.numeroProyecto ?? 'N/A' }}</div>
					</div>

					<div class="pta-anio-card pta-anio-card--stack">
						<label class="pta-field-label mb-2">
							<i class="bi bi-calendar-check"></i> Año de Ejecución
						</label>
						<div class="pta-show-year pta-show-year--compact">{{ encabezado.anioEjecucion }}</div>
					</div>
				</div>

				<div class="pta-info-col-main">
					<div class="pta-field-group">
						<label class="pta-field-label">
							<i class="bi bi-pencil-square"></i> Nombre del Proyecto
						</label>
						<div class="pta-show-text pta-show-text--nombre">{{ encabezado.nombre }}</div>
					</div>
					<div class="pta-field-group mt-3">
						<label class="pta-field-label">
							<i class="bi bi-bullseye"></i> Objetivo del Proyecto
						</label>
						<div class="pta-show-text pta-show-text--objetivo">{{ encabezado.objetivo }}</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	{# =========================================================
						       CONTENIDO PRINCIPAL
						       ========================================================= #}
	<div class="pta-module__content">

		{% for grafica in graficas %}

			{# =================================================
																		               CARD POR INDICADOR
																		               ================================================= #}
			<div
				class="pta-card pta-grafica-card mb-4">


				{# ================= HEADER INDICADOR ================= #}
				<div class="pta-card__header pta-indicador-header">

					<div class="pta-indicador-main">
						<h3 class="pta-indicador-title">
							{{ grafica.indicador }}
						</h3>
					</div>

					<div class="pta-indicador-stats">
						<div class="pta-stat">
							<span class="pta-stat-label">Valor base</span>
							<span class="pta-stat-value">
								{{ grafica.valor_base }}
							</span>
						</div>


						<div class="pta-stat">
							<span class="pta-stat-label">Meta</span>
							<span class="pta-stat-value">
								{{ grafica.meta }}{% if grafica.es_porcentaje %}%{% endif %}
							</span>
						</div>

						<div class="pta-stat">
							<span class="pta-stat-label">Tendencia</span>
							{% if grafica.tendencia == 'POSITIVA' %}
								<span class="pta-badge pta-badge-positiva">
									Positiva
								</span>
							{% else %}
								<span class="pta-badge pta-badge-negativa">
									Negativa
								</span>
							{% endif %}
						</div>

						<div class="pta-stat">
							<span class="pta-stat-label">Avance</span>
							<span class="pta-stat-value">
								{{ grafica.porcentaje }}%
							</span>
						</div>

					</div>
				</div>

				{# ================= BODY GRÁFICA ================= #}
				<div class="pta-card__body pta-chart-wrap">
					<canvas class="pta-chart"
						data-indicador="{{ grafica.indicador }}"
						data-meta="{{ grafica.meta_grafica }}"
						data-tendencia="{{ grafica.tendencia }}"
						data-serie='{{ grafica.serie|json_encode|raw }}'
						data-captura-pct="{{ grafica.captura_porcentaje is defined and grafica.captura_porcentaje ? '1' : '0' }}"
						data-valor-base="{{ grafica.valor_base }}">
					</canvas>
				</div>

				{# Sección de desglose por acciones eliminada:
				   el avance ya no se registra por acción sino por indicador #}

			</div>

		{% else %}

			<div class="text-center text-muted">
				No hay indicadores para mostrar.
			</div>

		{% endfor %}

	</div>

	{# =========================================================
						       RESPONSABLES DEL PROYECTO
						       ========================================================= #}
	<div class="pta-show">
		<div class="card pta-card mb-4">
			<div class="d-flex justify-content-between align-items-center mb-3 pta-resp-header">
				<h4 class="pta-title mb-0">
					<i class="bi bi-people-fill"></i> Responsables del Proyecto
				</h4>
			</div>

			<div class="resp-grid resp-grid--3">

				<div class="resp-card resp-card--responsables">
					<div class="resp-icon-wrap"><i class="bi bi-person-fill"></i></div>
					<div class="resp-role">Responsables</div>

					<div class="resp-list">
						<div class="resp-list-item">
							<div class="resp-list-item-info">
								<span class="resp-list-item-name">
									<i class="bi bi-person-check-fill"></i> {{ encabezado.responsable ?? '—' }}
									<span class="resp-oficial-tag">Oficial</span>
								</span>
								<span class="resp-list-item-puesto">{{ encabezado.responsable.puesto.nombre ?? '—' }}</span>
							</div>
						</div>

						{% for adicional in encabezado.responsablesAdicionales %}
							<div class="resp-list-item">
								<div class="resp-list-item-info">
									<span class="resp-list-item-name">
										<i class="bi bi-person"></i> {{ adicional.personal }}
									</span>
									<span class="resp-list-item-puesto">{{ adicional.personal.puesto.nombre ?? '—' }}</span>
								</div>
							</div>
						{% endfor %}
					</div>
				</div>

				<div class="resp-card">
					<div class="resp-icon-wrap"><i class="bi bi-person-badge"></i></div>
					<div class="resp-role">Supervisor del Proyecto</div>
					<div class="resp-name">{{ encabezado.responsables.supervisor }}</div>
					<div class="resp-puesto">{{ encabezado.responsables.supervisor.puesto.nombre ?? '—' }}</div>
				</div>

				<div class="resp-card">
					<div class="resp-icon-wrap"><i class="bi bi-person-check"></i></div>
					<div class="resp-role">Aval del Proyecto</div>
					<div class="resp-name">{{ encabezado.responsables.aval }}</div>
					<div class="resp-puesto">{{ encabezado.responsables.aval.puesto.nombre ?? '—' }}</div>
				</div>

			</div>
		</div>
	</div>

</section>
