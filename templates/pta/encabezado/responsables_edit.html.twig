<turbo-frame id="content">
	<section class="pta-resp-edit-page">

		<div class="pta-resp-edit-container">
			<div class="pta-resp-edit-shell">
				<div class="pta-resp-edit-topbar">
					<a href="{{ volver_path|default(path('app_encabezado_show', { id: encabezado.id })) }}"
						data-turbo-frame="content"
						data-turbo-action="replace"
						class="pta-resp-edit-back-btn">
						<i class="bi bi-arrow-left"></i>
						<span>Volver</span>
					</a>
				</div>

				<div class="pta-show card pta-card pta-info-card mb-4">
					<h4 class="pta-title">
						<i class="bi bi-file-earmark-text"></i> Información del Proyecto
					</h4>

					<div class="pta-info-grid">
						<div class="pta-info-col-side">
							<div class="pta-anio-card pta-anio-card--stack mb-3">
								<label class="pta-field-label mb-2"># Proyecto</label>
								<div class="pta-show-year pta-show-year--compact">{{ encabezado.numeroProyecto ?? 'N/A' }}</div>
							</div>

							<div class="pta-anio-card pta-anio-card--stack">
								<label class="pta-field-label mb-2">
									<i class="bi bi-calendar-check"></i> Año de Ejecución
								</label>
								<div class="pta-show-year pta-show-year--compact">{{ encabezado.anioEjecucion }}</div>
							</div>
						</div>

						<div class="pta-info-col-main">
							<div class="pta-field-group">
								<label class="pta-field-label">
									<i class="bi bi-pencil-square"></i> Nombre del Proyecto
								</label>
								<div class="pta-show-text pta-show-text--nombre">{{ encabezado.nombre }}</div>
							</div>
							<div class="pta-field-group mt-3">
								<label class="pta-field-label">
									<i class="bi bi-bullseye"></i> Objetivo del Proyecto
								</label>
								<div class="pta-show-text pta-show-text--objetivo">{{ encabezado.objetivo }}</div>
							</div>
						</div>
					</div>
				</div>

				<form method="post"
					action="{{ path('app_encabezado_responsables_edit', { id: encabezado.id }) }}"
					data-turbo-frame="content"
					id="responsables-form"
					class="pta-resp-edit-form">

				<div class="pta-resp-card">
					<h4 class="pta-resp-card-title">
						<i class="bi bi-people-fill"></i>
						Responsables del Proyecto
					</h4>

					<div class="pta-resp-fields">
						<div class="pta-resp-field">
							<div class="pta-resp-field-icon"><i class="bi bi-person-fill"></i></div>
							<label for="responsable-search">Responsable</label>
							<div class="pta-resp-input-wrap">
								<input type="hidden" name="responsable_id" value="{{ encabezado.responsable.id ?? '' }}">
								<input id="responsable-search"
									type="text"
									class="responsable-search"
									autocomplete="off"
									value="{{ encabezado.responsable ?? '' }}">
								<div class="responsable-results search-results"></div>
							</div>
						</div>

						<div class="pta-resp-field">
							<div class="pta-resp-field-icon"><i class="bi bi-person-badge"></i></div>
							<label for="supervisor-search">Supervisor</label>
							<div class="pta-resp-input-wrap">
								<input type="hidden" name="supervisor_id" value="{{ encabezado.responsables.supervisor.id ?? '' }}">
								<input id="supervisor-search"
									type="text"
									class="supervisor-search"
									autocomplete="off"
									value="{{ encabezado.responsables.supervisor ?? '' }}">
								<div class="supervisor-results search-results"></div>
							</div>
						</div>

						<div class="pta-resp-field">
							<div class="pta-resp-field-icon"><i class="bi bi-person-check"></i></div>
							<label for="aval-search">Aval</label>
							<div class="pta-resp-input-wrap">
								<input type="hidden" name="aval_id" value="{{ encabezado.responsables.aval.id ?? '' }}">
								<input id="aval-search"
									type="text"
									class="aval-search"
									autocomplete="off"
									value="{{ encabezado.responsables.aval ?? '' }}">
								<div class="aval-results search-results"></div>
							</div>
						</div>
					</div>
				</div>

				<input type="hidden" name="_token" value="{{ csrf_token('responsables_' ~ encabezado.id) }}">
			</form>

			<div class="pta-resp-card">
				<h4 class="pta-resp-card-title">
					<i class="bi bi-person-plus-fill"></i>
					Responsables Adicionales
					<span class="pta-resp-adicionales-count" id="resp-adicionales-count">{{ encabezado.responsablesAdicionales|length }}/5</span>
				</h4>

				<div class="pta-resp-adicionales-list">
					{% for adicional in encabezado.responsablesAdicionales %}
						<div class="pta-resp-adicional-item">
							<span class="pta-resp-adicional-nombre">
								<i class="bi bi-person"></i>
								{{ adicional.personal }}
							</span>
							<form method="post"
								action="{{ path('app_encabezado_responsable_adicional_eliminar', { id: encabezado.id, responsableAdicionalId: adicional.id }) }}"
								data-turbo-frame="content"
								onsubmit="return confirm('¿Eliminar a {{ adicional.personal }} de los responsables adicionales?');">
								<input type="hidden" name="_token" value="{{ csrf_token('responsables_' ~ encabezado.id) }}">
								<button type="submit" class="pta-resp-adicional-remove-btn" title="Eliminar responsable adicional">
									<i class="bi bi-trash3"></i>
								</button>
							</form>
						</div>
					{% else %}
						<p class="pta-resp-adicionales-empty">No hay responsables adicionales.</p>
					{% endfor %}
				</div>

				{% if encabezado.responsablesAdicionales|length < 5 %}
					<div
						data-collection-holder="nuevosResponsablesAdicionales"
						data-max="5"
						data-current-count="{{ encabezado.responsablesAdicionales|length }}"
						class="pta-resp-nuevos-container">
					</div>

					<button type="button" class="pta-resp-adicional-add-btn" id="add-responsable-adicional">
						<i class="bi bi-plus-lg"></i>
						Agregar
					</button>
				{% endif %}
			</div>

			<div class="pta-resp-actions">
				<button type="button" class="pta-resp-save-btn js-confirmar-responsables" id="btn-confirmar">
					<i class="bi bi-floppy2-fill"></i>
					<span>Guardar cambios</span>
				</button>
			</div>
			</div>
		</div>

		<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content pta-resp-modal">
					<div class="modal-header">
						<h5 class="modal-title">
							<i class="bi bi-shield-check"></i>
							Confirmar cambios
						</h5>
						<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
					</div>
					<div class="modal-body">
						<p class="pta-resp-modal-note">Revisa las asignaciones antes de guardar.</p>
						<ul id="lista-cambios" class="pta-resp-change-list list-group"></ul>
					</div>
					<div class="modal-footer">
						<button type="button" class="pta-resp-cancel-btn" data-bs-dismiss="modal">Cancelar</button>
						<button type="button" class="pta-resp-save-btn" id="btn-guardar-final">Confirmar</button>
					</div>
				</div>
			</div>
		</div>

	</section>
</turbo-frame>
